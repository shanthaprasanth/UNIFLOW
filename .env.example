# Reference only. The server creates a private .env automatically on first run,
# so you normally do NOT need to copy this file.
#
# If you want to set values by hand, copy this to .env and replace the secrets.
# Generate a random value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=replace_with_a_long_random_string
QR_SECRET=replace_with_a_different_long_random_string
PORT=3000

# Same-origin only by default. For a separate frontend, set its origin here.
CORS_ORIGIN=false
